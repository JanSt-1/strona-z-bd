NODE_ENV=production
# W środowisku produkcyjnym Express ukrywa szczegóły techniczne błędów, wyłącza stack trace w odpowiedziach i włącza optymalizacje pamięci podręcznej.
PORT=3000
HOST=127.0.0.1
# Domyślnie 127.0.0.1 (bezpieczny za reverse proxy / Nginx / Caddy). Ustaw 0.0.0.0, aby udostępnić w sieci lokalnej (LAN).
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=twoje_haslo_do_bazy
DB_NAME=serwis_db
DB_PORT=3306
JWT_SECRET=wygeneruj_wlasny
#Klucz generowany jest w ten sposób: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
